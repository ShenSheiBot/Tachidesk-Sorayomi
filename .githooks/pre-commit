#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
git diff --cached --check

# Check only staged Dart paths. Resolve their imports in the working tree, as
# the analyzer normally does; never stash, generate, fix, or stage user files.
dart_files=()
while IFS= read -r -d '' path; do
    case "$path" in
        *.dart) dart_files+=("$path") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "${#dart_files[@]}" -eq 0 ]; then
    exit 0
fi

printf '%s\n' 'Checking formatting of staged Dart files (read-only)...'
dart format --output=none --set-exit-if-changed "${dart_files[@]}"

printf '%s\n' 'Analyzing staged Dart files (errors/warnings are fatal; infos are not)...'
flutter analyze --no-pub --no-fatal-infos --fatal-warnings "${dart_files[@]}"
